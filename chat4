    # Zelcore Quirk: Seed — это HEX-строка, превращенная в байты
    seed_bytes = seed_hex.encode() 
    
    # Master Key
    I = hmac.new(b"Bitcoin seed", seed_bytes, hashlib.sha512).digest()
    k = I[:32]
    c = I[32:]
    
    # Функция Hardened деривации (m/i')
    def CKDpriv_hardened(k, c, i):
        # i' = i + 0x80000000
        i_hardened = i + 0x80000000
        data = b"\x00" + k + i_hardened.to_bytes(4, 'big')
        I_child = hmac.new(c, data, hashlib.sha512).digest()
        return I_child[:32], I_child[32:]

