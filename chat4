import hashlib
import hmac

# Эмуляция логики pybitcointools из v34.py
def bip32_master_key(seed_str):
    # В v34.py сид подается как строка
    I = hmac.new(b"Bitcoin seed", seed_str.encode(), hashlib.sha512).digest()
    return I[:32], I[32:]

def bip32_ckd(parent_priv, chain_code, index):
    # Упрощенная деривация (Non-hardened)
    # В Zelcore Legacy обычно используются индексы < 2^31
    import ecdsa # если нет, можно через hmac
    curve = ecdsa.SECP256k1
    secexp = int.from_hex(parent_priv.hex())
    pub = ecdsa.SigningKey.from_secret_exponent(secexp, curve=curve).get_verifying_key().to_string("compressed")
    
    data = pub + index.to_bytes(4, 'big')
    I = hmac.new(chain_code, data, hashlib.sha512).digest()
    
    child_priv = (int.from_hex(I[:32].hex()) + secexp) % curve.order
    return child_priv.to_bytes(32, 'big'), I[32:]

def createHashHex(data):
    return hashlib.sha256(hashlib.sha256(data.encode()).digest()).hexdigest()

