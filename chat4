    N, r, p = 16384, 8, 1
    
    print("--- ПОИСК c2f0 ЧЕРЕЗ SCRYPT (БЕЗ ПЕППЕРА) ---")

    # Варианты соли
    salts = [
        login,
        login.lower(),
        login + password,
        password + login,
        hashlib.sha256(login.encode()).hexdigest() # Хеш логина как соль
    ]

    for s_val in salts:
        print(f"\nТестируем соль: {s_val[:20]}...")
        
        # Zelcore может запрашивать 32 или 64 байта
        for dk in [32, 64]:
            res = hashlib.scrypt(password.encode(), salt=s_val.encode(), n=N, r=r, p=p, dklen=dk).hex()
            
            # Проверяем все возможные части результата
            if res == target_c2f0:
                print(f"🔥 НАЙДЕНО! c2f0 = Scrypt(pass, salt, dkLen={dk})")
                return
            if res[:64] == target_c2f0:
                print(f"🔥 НАЙДЕНО! c2f0 = Scrypt(pass, salt, dkLen={dk}) [Первые 32 байта]")
                return
            if dk == 64 and res[64:] == target_c2f0:
                print(f"🔥 НАЙДЕНО! c2f0 = Scrypt(pass, salt, dkLen={dk}) [Вторые 32 байта]")
                return

    print("\n❌ Scrypt не дал результата. Проверяем теорию 'Hex-Chain'...")
    # В FIND_ELECTRON_1 была странная логика: SHA256 от HEX-строки Scrypt
    for s_val in salts:
        res_full = hashlib.scrypt(password.encode(), salt=s_val.encode(), n=N, r=r, p=p, dklen=64).hex()
        # Попробуем SHA256 от всей 128-символьной строки
        check_chain = hashlib.sha256(res_full.encode()).hexdigest()
        if check_chain == target_c2f0:
            print(f"🔥 НАЙДЕНО! c2f0 = SHA256(Scrypt_Hex_Full). Соль: {s_val}")
            return

    print("❌ Ничего не совпало.")

if __name__ == "__main__":
    test_scrypt_variations()
```

