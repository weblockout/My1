### Скрипт на Python (использует библиотеку `requests`)

Для работы скрипта установи библиотеку requests, если её нет: `pip install requests`

```python
import time
import hashlib
import requests

def generate_auth_hash(username, password, timestamp):
    """
    ВАЖНО: Здесь нужно указать правильную строку, которую хеширует сайт.
    """
    # Пример 1: простое склеивание (пароль + время)
    raw_string = f"{password}{timestamp}"
    
    # Пример 2: склеивание с логином и солью (как вариант)
    # raw_string = f"{username}:{password}:{timestamp}"
    
    # Хешируем строку алгоритмом SHA-1
    return hashlib.sha1(raw_string.encode('utf-8')).hexdigest()

def login(username, password):
    url = "https://holytransaction.com/api/user/getId"
    
    # 1. Генерируем текущее время в миллисекундах (как в браузере)
    timestamp = str(int(time.time() * 1000))
    
    # 2. Генерируем наш x-auth хеш
    auth_hash = generate_auth_hash(username, password, timestamp)
    
    # 3. Формируем заголовки в точности как в твоем запросе
    headers = {
        "accept": "application/json, text/plain, */*",
        "content-type": "application/x-www-form-urlencoded;charset=utf-8",
        "origin": "https://holytransaction.com",
        "referer": "https://holytransaction.com/app",
        "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        "x-username": username,
        "x-timestamp": timestamp,
        "x-auth": f"APIAuth {auth_hash}"
        # Заголовок x-auth-old обычно можно опустить, серверу достаточно нового
    }
    
    print(f"[*] Отправляем запрос...")
    print(f"[*] Логин: {username}")
    print(f"[*] Timestamp: {timestamp}")
    print(f"[*] Сгенерированный x-auth: {headers['x-auth']}")
    
    # 4. Отправляем POST запрос (без тела, так как content-length: 0)
    response = requests.post(url, headers=headers)
    
    print(f"\n[+] Статус код: {response.status_code}")
    print(f"[+] Ответ сервера: {response.text}")

# Запускаем
login("buginot", "ScvDbn70@")
```

