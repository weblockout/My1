import hashlib
import hmac
import base64
import time

def generate_auth_headers(username, wallet_key, wallet_key_old, method, url, data=""):
    # Генерируем текущее время
    timestamp = str(int(time.time() * 1000))
    
    # 1. Хешируем тело запроса (data) алгоритмом SHA-256
    if method in ["POST", "PUT", "PATCH"]:
        # Так как у нас data пустая (content-length: 0), хешируется пустая строка
        data_sha256 = hashlib.sha256(data.encode('utf-8')).digest()
        # Кодируем результат в base64 (как указано в JS коде)
        params_sha2 = base64.b64encode(data_sha256).decode('utf-8')
    else:
        params_sha2 = base64.b64encode(hashlib.sha256(b"").digest()).decode('utf-8')

    # 2. Склеиваем строку через запятую
    auth_str = f"{username.lower()},{timestamp},{url},{params_sha2}"
    
    # 3. Генерируем финальный хеш HMAC-SHA1
    x_auth = hmac.new(wallet_key.encode('utf-8'), auth_str.encode('utf-8'), hashlib.sha1).hexdigest()
    x_auth_old = hmac.new(wallet_key_old.encode('utf-8'), auth_str.encode('utf-8'), hashlib.sha1).hexdigest()
    
    return {
        "x-auth": f"APIAuth {x_auth}",
        "x-auth-old": f"APIAuth {x_auth_old}",
        "x-username": username.lower(),
        "x-timestamp": timestamp
    }
```

