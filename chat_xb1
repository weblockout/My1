    FULL_FINGERPRINT = f.read().strip()

def get_session_data():
    """Открывает браузер на секунду, чтобы поймать UUID и куки"""
    co = ChromiumOptions()
    co.set_argument('--headless=new') # Можно включить, когда проверишь, что ловит
    co.set_argument('--disable-blink-features=AutomationControlled')
    
    page = ChromiumPage(co)
    # Слушаем запрос к визарду, который выдает UUID
    page.listen.start('api/v2/my/signin/wizard')
    
    try:
        page.get('https://my.xbtfx.com/en/auth/sign-in')
        print(f"{C}[*] Перехват UUID из браузера...{W}")
        
        res = page.listen.wait(timeout=15)
        if res:
            data = res.response.body
            if isinstance(data, str): data = json.loads(data)
            
            captured_uuid = data.get('data', {}).get('uuid')
            cookies = page.cookies(as_dict=True)
            ua = page.user_agent
            
            return captured_uuid, cookies, ua
        return None, None, None
    finally:
        page.quit()

def login_via_post(email, password, uuid_val, cookies, ua):
    """Отправляет быстрый POST запрос на авторизацию"""
    session = requests.Session(impersonate="chrome110")
    session.cookies.update(cookies)
    
    url = "https://api.xbtfx.com/api/v2/my/signin"
    
    headers = {
        'authority': 'api.xbtfx.com',
        'accept': 'application/json, text/plain, */*',
        'user-agent': ua,
        'content-type': 'application/json',
        'origin': 'https://my.xbtfx.com',
        'referer': 'https://my.xbtfx.com/',
        'x-datadog-origin': 'rum',
    }
    
    payload = {
        "uuid": uuid_val,
        "password": password,
        "device_fingerprint": FULL_FINGERPRINT,
        "email": email
    }

    try:
        response = session.post(url, headers=headers, json=payload, timeout=10)
        
        if response.status_code == 200 or response.status_code == 202:
            # Если успех, можно попробовать сразу дернуть баланс через API
            # Но для начала просто подтвердим вход
            return True, response.text
        elif "reached the limit" in response.text:
