from DrissionPage import ChromiumPage, ChromiumOptions
from curl_cffi import requests
import json
import time
import os
from colorama import Fore, init

init(autoreset=True)
G, R, Y, C, W = Fore.GREEN, Fore.RED, Fore.YELLOW, Fore.CYAN, Fore.WHITE

