            if current_streak >= 10:
                self.trigger_auto_pause(current_streak)
        
        with stats_lock: stats['left'] -= 1

    def trigger_auto_pause(self, streak):
        if not pause_event.is_set(): return
        pause_event.clear()

        def countdown_timer(duration_sec):
            for i in range(duration_sec, 0, -1):
                if pause_event.is_set(): break
                mins, secs = divmod(i, 60)
                sys.stdout.write(f"\r{Color.YELLOW}[!!!] ПАУЗА (10 FAIL). Ждем обновления IP: {mins:02d}:{secs:02d} {Color.RESET}")
                sys.stdout.flush()
                time.sleep(1)
            
            with stats_lock: stats['fail_streak'] = 0
            pause_event.set()
            log("\n[>>>] Работа возобновлена автоматически!", Color.CYAN)

        # Запускаем таймер на 40 минут (2400 секунд)
        threading.Thread(target=countdown_timer, args=(2400,), daemon=True).start()

# --- MAIN ---

def main():
    global all_proxies
    os.system('cls' if os.name == 'nt' else 'clear')
    log("=== VEXEL ENTERPRISE TURBO (AUTO-PAUSE 40 MIN) ===", Color.CYAN)
    
    path = input("\nПеретяните файл с аккаунтами: ").strip().replace('"', '').replace("'", "")
    if not os.path.exists(path): return

