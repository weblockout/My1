                    add_to_history(self.history_path, self.full_line)
                    with stats_lock:
                        stats['bad'] += 1
                        stats['fail_streak'] = 0 # Сброс, так как прокси пробил защиту
        except: pass

    def run(self):
        pause_event.wait() 
        with proxy_lock:
            current_proxies = random.sample(all_proxies, min(len(all_proxies), 1500))
        
        chunk_size = 500
