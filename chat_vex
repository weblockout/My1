    if not to_check: return
    
    # Очередь для волновой защиты
    for acc in to_check:
        account_queue.append([acc, 0, 0])

    threading.Thread(target=proxy_refresher, daemon=True).start()
    while not all_proxies: time.sleep(1)
    
