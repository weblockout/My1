    except: max_accs, threads_per_acc = 30, 50
    
    stats['left'] = len(account_queue)

    def master_worker():
        global global_stop
        while account_queue and not global_stop:
            try: acc_data = account_queue.popleft()
            except: break
            
            full_line, last_time, waves = acc_data
            if full_line in finished_accounts: continue

            # Защита малых списков
            wait_needed = MIN_CYCLE_TIME - (time.time() - last_time)
            if wait_needed > 0 and len(to_check) < 50:
                account_queue.append(acc_data)
                time.sleep(1)
                continue

            u, p = full_line.split(":", 1)
            checker = VexelChecker(u, p, threads_per_acc, history_file, full_line)
            
            if not checker.run_wave():
                acc_data[1] = time.time()
                acc_data[2] += 1
                if acc_data[2] >= MAX_WAVES_PER_ACC:
                    log(f"[FAIL] {u} - Сдаемся после {MAX_WAVES_PER_ACC} волн", Color.YELLOW)
                    with save_lock:
                        with open("failed_to_check.txt", "a", encoding="utf-8") as f: f.write(full_line + "\n")
                    add_to_history(history_file, full_line)
                    with stats_lock: stats['left'] -= 1
                else:
                    account_queue.append(acc_data)
                    with stats_lock: stats['deferred'] += 1
            else:
                with stats_lock: stats['left'] -= 1
            
            if not checker.found and not global_stop:
                with stats_lock:
                    stats['fail_streak'] += 1
                    if stats['fail_streak'] >= 10:
                        if stats['paused_once']:
                            log("\nОСТАНОВКА: Повторная серия из 10 FAIL.", Color.RED)
                            global_stop = True
                            return
                        else:
                            stats['paused_once'] = True
                            trigger_auto_pause()
            
            sys.stdout.write(f"\x1b]2;G:{stats['good']} B:{stats['bad']} BN:{stats['banned']} Left:{stats['left']} Def:{stats['deferred']}\x07")

    def trigger_auto_pause():
        if not pause_event.is_set(): return
        pause_event.clear()
        def countdown():
            for i in range(2400, 0, -1):
                if global_stop: break
                mins, secs = divmod(i, 60)
                sys.stdout.write(f"\r{Color.YELLOW}[!!!] ПАУЗА (10 FAIL). Ждем: {mins:02d}:{secs:02d} {Color.RESET}")
                sys.stdout.flush()
                time.sleep(1)
            with stats_lock: stats['fail_streak'] = 0
            pause_event.set()
            if not global_stop: log("\n[>>>] Работа возобновлена!", Color.CYAN)
        threading.Thread(target=countdown, daemon=True).start()

    with ThreadPoolExecutor(max_workers=max_accs) as executor:
        for _ in range(max_accs): executor.submit(master_worker)

    while not global_stop and stats['left'] > 0: time.sleep(1)
    log("\n--- РАБОТА ЗАВЕРШЕНА ---", Color.CYAN)
    input("Нажмите Enter для выхода...")

